      "html": "<div style=\"width:960px;height:540px;overflow:hidden;position:relative;background:#09090B;color:#FAFAFA;font-family:'Inter','Segoe UI',system-ui,sans-serif;display:flex;flex-direction:column;box-sizing:border-box;padding:44px 52px;\">\n  <div style=\"position:absolute;bottom:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#FBBF24,#F59E0B);\"></div>\n  <header style=\"flex:0 0 auto;margin-bottom:22px;display:flex;align-items:flex-start;max-width:100%;\">\n    <div style=\"width:4px;min-height:48px;border-radius:2px;background:linear-gradient(180deg,#FBBF24,#F59E0B);margin-right:14px;flex-shrink:0;\"></div>\n    <div style=\"flex:1;min-width:0;\">\n      <h1 style=\"margin:0;font-size:30px;line-height:1.12;font-weight:800;color:#FBBF24;max-width:640px;\">Agentic Workflow</h1>\n      <p style=\"margin:8px 0 0 0;font-size:16px;line-height:1.35;opacity:0.78;max-width:640px;\">How a mission unfolds.</p>\n    </div>\n  </header>\n  <main style=\"flex:1 1 auto;overflow:hidden;max-width:640px;min-height:0;\"><svg width=\"100%\" height=\"130\" viewBox=\"0 0 640 130\" xmlns=\"http://www.w3.org/2000/svg\" style=\"margin:8px 0 14px 0;\">\n  <defs><linearGradient id=\"wf\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\"><stop offset=\"0%\" stop-color=\"#FBBF24\"/><stop offset=\"100%\" stop-color=\"#F59E0B\"/></linearGradient></defs>\n  <rect x=\"8\" y=\"44\" width=\"108\" height=\"40\" rx=\"8\" fill=\"#FBBF24\" opacity=\"0.12\" stroke=\"#FBBF24\" stroke-width=\"1.5\"/>\n  <text x=\"62\" y=\"69\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"#FBBF24\">Plan</text>\n  <line x1=\"116\" y1=\"64\" x2=\"148\" y2=\"64\" stroke=\"#FBBF24\" stroke-width=\"2\"/>\n  <rect x=\"152\" y=\"44\" width=\"108\" height=\"40\" rx=\"8\" fill=\"#FBBF24\" opacity=\"0.12\" stroke=\"#FBBF24\" stroke-width=\"1.5\"/>\n  <text x=\"206\" y=\"69\" text-anchor=\"middle\" font-size=\"12\" font-weight=\"600\" fill=\"#FBBF24\">Execute</text>\n  <line x1=\"260\" y1=\"64\"