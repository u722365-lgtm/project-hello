# ShadowTalk AI - Environment Variables
# Copy this file to .env and fill in your actual values
#
# REQUIRED before building the desktop app (.exe):
#   copy env.example .env   (Windows)
#   npm run desktop:make

# ============================================
# LOCAL-FIRST BY DEFAULT
# ============================================
# ShadowTalk runs fully on-device (Ollama / WebLLM / WebGPU).
# No external backend is required. Leave the API vars empty for pure local mode.

# Optional self-hosted API (only if you run your own ShadowTalk API server)
VITE_API_BASE_URL=
VITE_API_KEY=

# Force local-only routing (no network calls at all)
# VITE_LOCAL_FIRST=true

# ============================================
# OPTIONAL FRONTEND FLAGS
# ============================================
# VITE_ENTERPRISE_MODE=true
# VITE_ENTERPRISE_DOMAINS=example.com
# VITE_TWILIO_WHATSAPP_NUMBER=+14155238886
# VITE_LEMONSQUEEZY_VARIANT_PRO=your_pro_variant_id
# VITE_LEMONSQUEEZY_VARIANT_PREMIUM=your_premium_variant_id
# VITE_LEMONSQUEEZY_VARIANT_ELITE=your_elite_variant_id

# ============================================
# SECURITY NOTES
# ============================================
# 1. NEVER commit this file with real values to git
# 2. Frontend keys (VITE_*) are public — only use publishable keys
# 3. Bring-your-own-key provider secrets are stored on-device, never in this file
