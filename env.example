# ShadowTalk AI - Environment Variables
# Copy this file to .env and fill in your actual values
#
# REQUIRED before building the desktop app (.exe):
#   copy env.example .env   (Windows)
#   npm run desktop:make

# ============================================
# SUPABASE (REQUIRED for cloud features)
# ============================================
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API
# VITE_API_BASE_URL = your Supabase Project URL
# VITE_API_KEY = your Supabase Anon (public) Key
# These are PUBLIC keys (exposed in browser) — safe to commit if using .env.example

# Your Supabase project URL (e.g. https://xxxx.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase publishable key (from Dashboard → Settings → API)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy aliases (optional — client.ts falls back to these)
# VITE_API_BASE_URL=
# VITE_API_KEY=

# ============================================
# LOCAL-FIRST (fallback when Supabase not set)
# ============================================
# ShadowTalk runs fully on-device (Ollama / WebLLM / WebGPU) when Supabase is not configured.
# All backend operations become safe no-ops in local-only mode.

# Force local-only routing (no network calls at all)
# VITE_LOCAL_FIRST=true

# ============================================
# PAYMENT - LEMONSQUEEZY (client-side variant IDs)
# ============================================
# Get from: https://app.lemonsqueezy.com → Products → Your Product → Variants
VITE_LEMONSQUEEZY_VARIANT_PRO=
VITE_LEMONSQUEEZY_VARIANT_PREMIUM=
VITE_LEMONSQUEEZY_VARIANT_ELITE=

# ============================================
# OPTIONAL FRONTEND FLAGS
# ============================================
# VITE_ENTERPRISE_MODE=true
# VITE_ENTERPRISE_DOMAINS=example.com
# VITE_TWILIO_WHATSAPP_NUMBER=+14155238886
# VITE_ENABLE_LOCATION_TRACKING=true
# VITE_ENABLE_PROACTIVE_AI=true
# VITE_ENABLE_BYOK_EDGE=true
# VITE_SELF_HEAL_ENABLED=true
# VITE_OFFLINE_MODEL_CDN_URL=https://cdn.yourdomain.com/mlc-models

# ============================================
# SERVER-SIDE SECRETS (set in Supabase Dashboard, NOT here)
# ============================================
# These go to: Supabase Dashboard → Edge Functions → Secrets
#
# SUPABASE_SERVICE_ROLE_KEY=     (auto-set by Supabase)
# GEMINI_API_KEY=                 (Google AI Studio)
# OPENAI_API_KEY=                 (platform.openai.com)
# GROQ_API_KEY=                   (console.groq.com)
# ELEVENLABS_API_KEY=             (elevenlabs.io)
# RESEND_API_KEY=                 (resend.com)
# FROM_EMAIL=noreply@shadowtalk-ai.com
# CONTACT_EMAIL=founder@shadowtalk-ai.com
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# LEMONSQUEEZY_API_KEY=           (app.lemonsqueezy.com)
# SERP_API_KEY=                   (serpapi.com)
# TAVILY_API_KEY=                 (tavily.com)
# FIRECRAWL_API_KEY=              (firecrawl.dev)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=

# ============================================
# SECURITY NOTES
# ============================================
# 1. NEVER commit .env with real values to git
# 2. VITE_* vars are PUBLIC (embedded in JS bundle) — only use anon/publishable keys
# 3. Server secrets (API keys, webhooks) go in Supabase Edge Function secrets, NEVER in .env
# 4. BYOK provider keys are stored on-device in localStorage, never in this file

# ============================================
# FIREBASE (backend: Auth + Firestore + Storage)
# ============================================
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup
# These are PUBLIC config values (safe in the browser). Access is controlled by
# Firestore/Storage Security Rules, not by these keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
