# ShadowTalk AI - Environment Variables
# Copy this file to .env and fill in your actual values
#
# ShadowTalk runs fully on-device (WebLLM / WebGPU / Ollama).
# BYOK API keys are stored in localStorage via the Settings UI.
# No cloud backend required.

# ============================================
# LOCAL-FIRST (default mode)
# ============================================
# All backend operations are safe no-ops when no cloud backend is configured.
# Inference uses BYOK (your own keys) or WebLLM (browser-based).

# Force local-only routing (no network calls at all)
# VITE_LOCAL_FIRST=true

# ============================================
# OPTIONAL FRONTEND FLAGS
# ============================================
# VITE_ENTERPRISE_MODE=true
# VITE_ENTERPRISE_DOMAINS=example.com
# VITE_TWILIO_WHATSAPP_NUMBER=+14155238886
# VITE_ENABLE_LOCATION_TRACKING=true
# VITE_ENABLE_PROACTIVE_AI=true
# VITE_ENABLE_BYOK_EDGE=true
# VITE_SELF_HEAL_ENABLED=true
# VITE_OFFLINE_MODEL_CDN_URL=https://cdn.yourdomain.com/mlc-models
# VITE_PROMO_BANNER_TEXT=🎉 50% off Pro — limited time!
# VITE_PROMO_BANNER_CODE=SHADOW50
# VITE_PROMO_BANNER_ENDS=2026-09-01
# VITE_OMNIROUTE_ENABLED=1
# VITE_OMNIROUTE_API_KEY=

# ============================================
# SECURITY NOTES
# ============================================
# 1. NEVER commit .env with real values to git
# 2. BYOK provider keys are stored on-device in localStorage, never in this file

# ============================================
# FIREBASE (permanent backend)
# ============================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Functions base URL (defaults to https://<region>-<project>.cloudfunctions.net)
VITE_FIREBASE_FUNCTIONS_URL=
VITE_FIREBASE_REGION=us-central1
