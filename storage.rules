rules_version = '2';

// ShadowTalk AI — Cloud Storage Security Rules
// Deploy with: firebase deploy --only storage
// Paths are written by the adapter as: <bucket-name>/<path>
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Public, read-only assets (logos, share images).
    match /public-assets/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    // Marketing/email assets — read-only for everyone, no client writes.
    match /email-assets/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is private, namespaced per user: <bucket>/<uid>/<file>
    match /{logicalBucket}/{uid}/{allPaths=**} {
      allow read, write: if signedIn() && request.auth.uid == uid
        && request.resource == null || (
          signedIn() && request.auth.uid == uid && request.resource.size < 25 * 1024 * 1024
        );
    }
  }
}
