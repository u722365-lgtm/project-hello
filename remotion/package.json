{
  "name": "@shadowtalk/viral-video",
  "private": true,
  "version": "1.0.0",
  "description": "Code-driven viral shorts for ShadowTalk AI (Remotion)",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ViralShort out/viral-short.mp4",
    "render:privacy": "remotion render src/index.ts ViralShort out/viral-privacy.mp4 --props='{\"hookVariant\":\"privacy\"}'",
    "render:developer": "remotion render src/index.ts ViralShort out/viral-developer.mp4 --props='{\"hookVariant\":\"developer\"}'",
    "render:student": "remotion render src/index.ts ViralShort out/viral-student.mp4 --props='{\"hookVariant\":\"student\"}'",
    "render:all": "npm run render:privacy && npm run render:developer && npm run render:student"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.272",
    "@remotion/player": "^4.0.272",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.272"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.8.3"
  }
}
